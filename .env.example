# ============================================================
# BOSS数智平台 环境配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 合并来源：data_agent(BOSS问数) + knowledge_base(BOSS智库)
# ============================================================

# ============ 共用 LLM（OpenAI 兼容，BOSS智库使用）============
# 在 https://siliconflow.cn 或对应平台申请 API Key
OPENAI_API_KEY=sk-your-api-key-here
# API 基础地址
OPENAI_API_BASE=https://api.siliconflow.cn/v1
# 默认 LLM 模型 / 温度
LLM_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=Pro/moonshotai/Kimi-K2.6
# 商品名识别模型
ITEM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ============ BOSS问数 LLM（覆盖 conf/app_config.yaml）============
# 不设置时回落到 yaml 中的值；设置后以环境变量为准
DA_LLM_MODEL=deepseek-v4-flash-202605
DA_LLM_API_KEY=sk-your-da-api-key-here
DA_LLM_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3

# BOSS问数 MySQL（数仓 dw + 元库 meta，与 docker-compose.yml 中一致）
MYSQL_USER=itwwy
MYSQL_PASSWORD=your-mysql-password

# ============ BOSS智库：模型与缓存 ============
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
MD_ROOT_DIR=./temp-files/

# BGE-M3 本地模型（GPU）
BGE_M3_PATH=F:\ai_model\modelscope\models\BAAI\bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True

# ============ BOSS智库：Milvus ============
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ============ BOSS智库：MongoDB ============
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001

# ============ BOSS智库：MinIO ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=/upload-images

# ============ BOSS智库：MCP / MinerU / 重排序 ============
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_API_KEY=sk-ws-your-mcp-key-here
MINERU_API_TOKEN=sk-your-mineru-token-here
MINERU_BASE_URL=https://mineru.net/api/v4
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落

# ============ 文件存储根目录 ============
DATA_BASED_ROOT_DIR=D:\file

# ============ 审查模块（新增）============
# SQL 审查：单次查询返回行数上限（无 LIMIT 时自动追加）
SQL_REVIEW_MAX_LIMIT=1000
# 是否禁止访问系统库（information_schema/mysql/performance_schema/sys）
SQL_REVIEW_FORBID_SYSTEM_DB=true
# 内容审查：自定义敏感词文件（每行一个词，# 开头为注释）
REVIEW_SENSITIVE_WORDS_FILE=review/sensitive_words.txt
# 审计日志目录
REVIEW_AUDIT_DIR=logs/audit
